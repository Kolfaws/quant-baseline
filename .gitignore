# =============================================================================
# .gitignore — quant-baseline
#
# 结构：敏感信息 → 数据/仓库 → Python 产物 → 虚拟环境 → 日志 → 缓存 → 编辑器
# =============================================================================

# ------------------------------------------------------------------ 1. 敏感信息
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.yaml
secrets.yml

# ------------------------------------------------------------------ 2. 数据与仓库
# data/ 下的数据文件不进版本库，但保留目录结构
data/**
!data/
!data/raw/
!data/processed/
!data/**/.gitkeep


# 各类数据文件（防止在 data/ 之外误提交）
*.parquet
*.feather
*.arrow
*.csv
*.tsv
*.xlsx
*.xls
*.db
*.db-journal
*.db-wal
*.db-shm
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.h5
*.hdf5
*.pkl
*.pickle
*.zip

# ------------------------------------------------------------------ 3. Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 类型/构建工具的本地缓存
.mypy_cache/
.dmypy.json
.pytest_cache/
.ruff_cache/
.benchmarks/

# 测试与覆盖率
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------ 4. 虚拟环境
.venv/
venv/
env/
ENV/
.conda/

# ------------------------------------------------------------------ 5. 日志
*.log
logs/**
!logs/.gitkeep

# ------------------------------------------------------------------ 6. 编辑器 / 系统
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
!.vscode/settings.json.example
*.swp
*.swo
*~
.ipynb_checkpoints/

# ------------------------------------------------------------------ 7. 临时文件
*.tmp
*.temp
*.bak
*.orig
*.rej
~$*
