# =============================================================================
# .env.example — 环境变量模板
#
# 使用方式：复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交。
#     cp .env.example .env          # Linux / macOS
#     Copy-Item .env.example .env   # PowerShell
#
# 优先级：真实环境变量 > .env > configs/*.yaml 中的默认值
# =============================================================================

# ------------------------------------------------------------------ 数据源
# Tushare Token：https://tushare.pro/user/token
TUSHARE_TOKEN=

# 备选数据源（akshare 免 Token，安装 extra 后可用）
# AKSHARE_ENABLED=false

# ------------------------------------------------------------------ 数据库
# 选用 configs/database.yaml 中的哪个 profile：local / remote / sqlite
BASELINE_DB_PROFILE=local

# 本地仓库文件路径（相对项目根目录）
BASELINE_DB_PATH=warehouse/baseline.db

# 远端连接串（仅 remote profile 使用）
# duckdb 远端：s3://bucket/path/baseline.db、md:baseline
# postgres 示例：postgresql://user:password@host:5432/quant
BASELINE_DB_REMOTE_PATH=

# ------------------------------------------------------------------ 日志
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
LOG_DIR=logs

# ------------------------------------------------------------------ 其他
# 时区：容器/CI 环境下显式指定，保证 trade_date 解析一致
TZ=Asia/Shanghai
