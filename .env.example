# =============================================================================
# .env.example — quant-baseline 环境变量模板
#
#   cp .env.example .env          # Linux / macOS
#   Copy-Item .env.example .env   # PowerShell
#
# 优先级：真实环境变量 > .env > configs/*.yaml
# =============================================================================

# 连接档案：production / research（对应 configs/database.yaml）
BASELINE_DB_PROFILE=production

# 数据库绝对路径
MARKET_DB_PATH= YOUR_MARKET_DB_PATH
BACKTEST_DB_PATH= YOUR_BACKTEST_DB_PATH

# 日志
LOG_LEVEL=INFO
LOG_DIR=logs

TZ=Asia/China
